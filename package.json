{
  "name": "hodipor",
  "version": "0.1.0",
  "description": "A general-purpose, extensible terminal agent powered by Pi",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hodipor": "src/cli.mjs"
  },
  "files": [
    "src",
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AppChainAI/Hodipor.git"
  },
  "homepage": "https://github.com/AppChainAI/Hodipor#readme",
  "keywords": [
    "agent",
    "cli",
    "terminal",
    "ai",
    "llm",
    "harness"
  ],
  "scripts": {
    "start": "node src/cli.mjs",
    "dev": "node src/cli.mjs",
    "check": "tsc --noEmit",
    "test": "node --test --test-timeout=120000 --test-force-exit test/*.test.mjs extensions/todo/test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
