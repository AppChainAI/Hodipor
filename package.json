{
  "name": "siftory",
  "version": "0.1.0",
  "private": true,
  "description": "A general-purpose, extensible terminal agent powered by Pi",
  "type": "module",
  "bin": {
    "siftory": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "dev": "node src/cli.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs extensions/todo/test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
